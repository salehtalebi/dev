# WordPress & WooCommerce API Configuration
VITE_API_BASE_URL=http://localhost:2145/nuvior
VITE_WP_API_ENDPOINT=/wp-json/wp/v2
VITE_WC_API_ENDPOINT=/wp-json/wc/v3
VITE_JWT_ENDPOINT=/wp-json/jwt-auth/v1

# WooCommerce API Keys (اگر از Consumer Key/Secret استفاده می‌کنید)
VITE_WC_CONSUMER_KEY=your_consumer_key_here
VITE_WC_CONSUMER_SECRET=your_consumer_secret_here

# App Configuration
VITE_APP_NAME="Sales Dashboard"
VITE_APP_DESCRIPTION="Dashboard for Academy Sales Management"
